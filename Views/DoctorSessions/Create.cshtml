@model BeykentHospitalAppointment.Models.DoctorSession

@{
    ViewData["Title"] = "Yeni Seans Ekle";
}

<style>
    .form-page {
        padding: 34px 0 20px;
    }

    .form-header {
        background: linear-gradient(135deg, #0f2d4a 0%, #174ea6 100%);
        color: white;
        border-radius: 30px;
        padding: 34px;
        box-shadow: 0 24px 60px rgba(21, 64, 105, 0.16);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

    .form-header::before {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        right: -80px;
        top: -80px;
    }

    .form-header h1 {
        color: white;
        margin: 0 0 10px;
        position: relative;
        z-index: 2;
    }

    .form-header p {
        color: #d9e8ff;
        margin: 0;
        line-height: 1.65;
        max-width: 780px;
        position: relative;
        z-index: 2;
    }

    .form-card-modern {
        background: #ffffff;
        border: 1px solid #dbe8f4;
        border-radius: 28px;
        box-shadow: 0 18px 44px rgba(21, 64, 105, 0.09);
        padding: 34px;
        max-width: 820px;
    }

    .form-section-title {
        color: #102a43;
        font-weight: 950;
        margin-bottom: 8px;
    }

    .form-section-text {
        color: #60758a;
        margin-bottom: 26px;
        line-height: 1.6;
    }

    .form-grid-modern {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .form-grid-modern .full {
        grid-column: 1 / -1;
    }

    .availability-box {
        background: #f8fbff;
        border: 1px solid #dbe8f4;
        border-radius: 18px;
        padding: 16px;
        margin-top: 4px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    @@media (max-width: 768px) {
        .form-card-modern {
            padding: 26px;
        }

        .form-header {
            padding: 28px;
        }

        .form-grid-modern {
            grid-template-columns: 1fr;
        }

        .form-grid-modern .full {
            grid-column: auto;
        }
    }
</style>

<section class="form-page">
    <div class="form-header">
        <h1>Yeni Seans Ekle</h1>

        <p>
            Doktorlara ait müsait tarih ve saat aralıklarını bu sayfadan oluşturabilirsiniz.
            Hasta randevu alırken yalnızca müsait olarak işaretlenen seansları görüntüler.
        </p>
    </div>

    <div class="form-card-modern">
        <h4 class="form-section-title">Seans Bilgileri</h4>

        <p class="form-section-text">
            Doktoru, tarihi ve saat aralığını seçerek yeni seans kaydı oluşturun.
        </p>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid-modern">
                <div class="full">
                    <label asp-for="DoctorId" class="form-label">Doktor</label>
                    <select asp-for="DoctorId"
                            class="form-control"
                            asp-items="ViewBag.DoctorId">
                        <option value="">Doktor seçiniz</option>
                    </select>
                    <span asp-validation-for="DoctorId" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="SessionDate" class="form-label">Tarih</label>
                    <input asp-for="SessionDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="SessionDate" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="StartTime" class="form-label">Başlangıç Saati</label>
                    <input asp-for="StartTime"
                           type="time"
                           class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="EndTime" class="form-label">Bitiş Saati</label>
                    <input asp-for="EndTime"
                           type="time"
                           class="form-control" />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>

                <div class="full">
                    <div class="availability-box">
                        <div class="form-check">
                            <input asp-for="IsAvailable"
                                   class="form-check-input" />

                            <label asp-for="IsAvailable" class="form-check-label">
                                Bu seans hasta randevusu için müsait olsun
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    Kaydet
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Listeye Dön
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}