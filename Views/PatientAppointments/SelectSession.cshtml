@model IEnumerable<BeykentHospitalAppointment.Models.DoctorSession>

@{
    ViewData["Title"] = "Seans Seç";
}

<h1>Seans Seç</h1>

<p class="text-muted">
    Seçilen branş: <strong>@ViewBag.DepartmentName</strong>
</p>

<p class="text-muted">
    Seçilen doktor: <strong>@ViewBag.DoctorName</strong>
</p>

<a asp-action="ChooseDepartment" class="btn btn-secondary mb-3">Başa Dön</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>Başlangıç Saati</th>
            <th>Bitiş Saati</th>
            <th>Durum</th>
            <th>İşlem</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var session in Model)
        {
            <tr>
                <td>@session.SessionDate.ToString("dd.MM.yyyy")</td>
                <td>@session.StartTime.ToString(@"hh\:mm")</td>
                <td>@session.EndTime.ToString(@"hh\:mm")</td>
                <td>
                    @if (session.IsAvailable)
                    {
                        <span class="badge bg-success">Müsait</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Dolu</span>
                    }
                </td>
                <td>
                    <a asp-action="Create"
                       asp-route-sessionId="@session.Id"
                       class="btn btn-primary btn-sm">
                        Bu Seansı Seç
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>