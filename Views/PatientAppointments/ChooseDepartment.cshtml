@model IEnumerable<BeykentHospitalAppointment.Models.Department>

@{
    ViewData["Title"] = "Branş Seç";
}

<h1>Randevu Al</h1>

<p class="text-muted">
    Randevu almak istediğiniz hastane branşını seçiniz.
</p>

<div class="row">
    @foreach (var department in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@department.Name</h5>
                    <p class="card-text">@department.Description</p>

                    <a asp-action="SelectDoctor"
                       asp-route-departmentId="@department.Id"
                       class="btn btn-primary">
                        Bu Branşı Seç
                    </a>
                </div>
            </div>
        </div>
    }
</div>