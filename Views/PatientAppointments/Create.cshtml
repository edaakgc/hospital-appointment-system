@model BeykentHospitalAppointment.Models.DoctorSession

@{
    ViewData["Title"] = "Randevu Onay";
}

<h1>Randevu Onay</h1>

<p class="text-muted">
    Seçtiğiniz randevu bilgilerini kontrol edip ödeme tipini seçiniz.
</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="card-title">@Model.Doctor?.FullName</h4>

        <p>
            <strong>Branş:</strong> @Model.Doctor?.Department?.Name
        </p>

        <p>
            <strong>Uzmanlık:</strong> @Model.Doctor?.Specialty
        </p>

        <p>
            <strong>Tarih:</strong> @Model.SessionDate.ToString("dd.MM.yyyy")
        </p>

        <p>
            <strong>Saat:</strong> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")
        </p>

        <p>
            <strong>Muayene Ücreti:</strong> @Model.Doctor?.ExaminationFee TL
        </p>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="sessionId" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Ödeme Tipi</label>

        <select name="paymentType" class="form-control" required>
            <option value="">Ödeme tipi seçiniz</option>
            <option value="Online Ödeme">Online Ödeme</option>
            <option value="Hastanede Ödeme">Hastanede Ödeme</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Randevuyu Onayla</button>

    <a asp-action="ChooseDepartment" class="btn btn-secondary">Vazgeç</a>
</form>