@model IEnumerable<BeykentHospitalAppointment.Models.Department>

@{
    ViewData["Title"] = "Branş Yönetimi";
}

<style>
    .management-page {
        padding: 34px 0 20px;
    }

    .management-header {
        background: linear-gradient(135deg, #0f2d4a 0%, #174ea6 100%);
        color: white;
        border-radius: 30px;
        padding: 36px;
        box-shadow: 0 24px 60px rgba(21, 64, 105, 0.16);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

    .management-header::before {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        right: -80px;
        top: -80px;
    }

    .management-header h1 {
        color: white;
        margin: 0 0 10px;
        position: relative;
        z-index: 2;
    }

    .management-header p {
        color: #d9e8ff;
        max-width: 820px;
        line-height: 1.65;
        margin: 0;
        position: relative;
        z-index: 2;
    }

    .management-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .management-summary {
        background: #ffffff;
        border: 1px solid #dbe8f4;
        border-radius: 18px;
        padding: 13px 18px;
        color: #60758a;
        font-weight: 800;
        box-shadow: 0 12px 30px rgba(21, 64, 105, 0.07);
    }

    .management-summary strong {
        color: #174ea6;
    }

    .management-table-card {
        background: #ffffff;
        border: 1px solid #dbe8f4;
        border-radius: 28px;
        box-shadow: 0 18px 44px rgba(21, 64, 105, 0.09);
        overflow: hidden;
    }

    .management-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

    .management-table thead {
        background: #102a43;
        color: white;
    }

    .management-table th {
        padding: 18px 16px;
        font-weight: 900;
        border: none;
        white-space: nowrap;
    }

    .management-table td {
        padding: 18px 16px;
        vertical-align: middle;
        border-bottom: 1px solid #edf3f8;
        color: #27364a;
        font-weight: 600;
    }

    .management-table tbody tr:nth-child(odd) {
        background: #f8fbff;
    }

    .management-table tbody tr:hover {
        background: #eef5ff;
    }

    .name-cell {
        font-weight: 950;
        color: #102a43;
        white-space: nowrap;
    }

    .description-cell {
        color: #60758a;
        line-height: 1.55;
    }

    .action-group {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .empty-management {
        background: #ffffff;
        border: 1px solid #dbe8f4;
        border-radius: 28px;
        padding: 42px;
        text-align: center;
        box-shadow: 0 18px 44px rgba(21, 64, 105, 0.09);
    }

    .empty-management h4 {
        color: #102a43;
        font-weight: 950;
        margin-bottom: 10px;
    }

    .empty-management p {
        color: #60758a;
        margin-bottom: 22px;
    }

    @@media (max-width: 900px) {
        .management-header {
            padding: 28px;
        }

        .management-table-card {
            overflow-x: auto;
        }

        .management-table {
            min-width: 780px;
        }
    }
</style>

<section class="management-page">
    <div class="management-header">
        <h1>Branş Yönetimi</h1>

        <p>
            Admin paneli üzerinden hastanede hizmet verilen branşlar görüntülenebilir,
            yeni branş eklenebilir, mevcut branş bilgileri düzenlenebilir veya uygun durumdaki
            branş kayıtları silinebilir.
        </p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="management-toolbar">
        <div class="management-summary">
            Toplam branş:
            <strong>@Model.Count()</strong>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Yeni Branş Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-management">
            <h4>Henüz branş kaydı bulunmamaktadır.</h4>

            <p>
                Hastanede hizmet verilecek branşları ekleyerek doktor ve randevu süreçlerini oluşturabilirsiniz.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Branş Ekle
            </a>
        </div>
    }
    else
    {
        <div class="management-table-card">
            <table class="management-table">
                <thead>
                    <tr>
                        <th>Branş Adı</th>
                        <th>Açıklama</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var department in Model)
                    {
                        <tr>
                            <td class="name-cell">
                                @department.Name
                            </td>

                            <td class="description-cell">
                                @department.Description
                            </td>

                            <td>
                                <div class="action-group">
                                    <a asp-action="Details"
                                       asp-route-id="@department.Id"
                                       class="btn btn-info btn-sm">
                                        Detay
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@department.Id"
                                       class="btn btn-warning btn-sm">
                                        Düzenle
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@department.Id"
                                       class="btn btn-danger btn-sm">
                                        Sil
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>