@model BeykentHospitalAppointment.Models.Department

@{
    ViewData["Title"] = "Branş Düzenle";
}

<style>
    .form-page {
        padding: 34px 0 20px;
    }

    .form-header {
        background: linear-gradient(135deg, #0f2d4a 0%, #174ea6 100%);
        color: white;
        border-radius: 30px;
        padding: 34px;
        box-shadow: 0 24px 60px rgba(21, 64, 105, 0.16);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

    .form-header::before {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        right: -80px;
        top: -80px;
    }

    .form-header h1 {
        color: white;
        margin: 0 0 10px;
        position: relative;
        z-index: 2;
    }

    .form-header p {
        color: #d9e8ff;
        margin: 0;
        line-height: 1.65;
        max-width: 760px;
        position: relative;
        z-index: 2;
    }

    .form-card-modern {
        background: #ffffff;
        border: 1px solid #dbe8f4;
        border-radius: 28px;
        box-shadow: 0 18px 44px rgba(21, 64, 105, 0.09);
        padding: 34px;
        max-width: 760px;
    }

    .form-section-title {
        color: #102a43;
        font-weight: 950;
        margin-bottom: 8px;
    }

    .form-section-text {
        color: #60758a;
        margin-bottom: 26px;
        line-height: 1.6;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    @@media (max-width: 768px) {
        .form-card-modern {
            padding: 26px;
        }

        .form-header {
            padding: 28px;
        }
    }
</style>

<section class="form-page">
    <div class="form-header">
        <h1>Branş Düzenle</h1>

        <p>
            Mevcut branş kaydına ait ad ve açıklama bilgilerini güncelleyebilirsiniz.
            Bu değişiklikler admin panelindeki branş listesine yansıtılır.
        </p>
    </div>

    <div class="form-card-modern">
        <h4 class="form-section-title">Branş Bilgileri</h4>

        <p class="form-section-text">
            Güncellemek istediğiniz alanları düzenleyip işlemi tamamlayın.
        </p>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Branş Adı</label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="Örn: Kardiyoloji" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Branş hakkında kısa açıklama yazınız."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    Güncelle
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Listeye Dön
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}