@{
    ViewData["Title"] = "Yetkisiz Erişim";
}

<style>
    .access-page {
        min-height: calc(100vh - 210px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 0;
    }

    .access-card {
        width: 100%;
        max-width: 720px;
        background: #ffffff;
        border: 1px solid #dbe8f4;
        border-radius: 34px;
        box-shadow: 0 28px 70px rgba(21, 64, 105, 0.13);
        overflow: hidden;
        text-align: center;
    }

    .access-top {
        background: linear-gradient(135deg, #0f2d4a 0%, #174ea6 100%);
        padding: 44px 34px;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .access-top::before {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        right: -80px;
        top: -80px;
    }

    .access-code {
        display: inline-block;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.25);
        padding: 8px 15px;
        border-radius: 999px;
        font-weight: 900;
        margin-bottom: 16px;
        position: relative;
        z-index: 2;
    }

    .access-top h1 {
        color: white;
        margin: 0;
        font-weight: 950;
        position: relative;
        z-index: 2;
    }

    .access-body {
        padding: 36px;
    }

    .access-body h4 {
        color: #102a43;
        font-weight: 950;
        margin-bottom: 12px;
    }

    .access-body p {
        color: #60758a;
        line-height: 1.7;
        max-width: 560px;
        margin: 0 auto 26px;
    }

    .access-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }
</style>

<section class="access-page">
    <div class="access-card">
        <div class="access-top">
            <span class="access-code">Yetki Kontrolü</span>

            <h1>Yetkisiz Erişim</h1>
        </div>

        <div class="access-body">
            <h4>Bu sayfaya erişim yetkiniz bulunmamaktadır.</h4>

            <p>
                Giriş yaptığınız kullanıcı rolü bu sayfayı görüntülemek için uygun değildir.
                Hasta kullanıcılar yalnızca randevu işlemlerini, admin kullanıcılar ise yönetim işlemlerini kullanabilir.
            </p>

            <div class="access-actions">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary">
                    Ana Sayfaya Dön
                </a>

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="btn btn-secondary">
                    Çıkış Yap
                </a>
            </div>
        </div>
    </div>
</section>