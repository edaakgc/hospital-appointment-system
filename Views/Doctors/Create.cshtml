@model BeykentHospitalAppointment.Models.Doctor

@{
    ViewData["Title"] = "Yeni Doktor Ekle";
}

<style>
    .form-page {
        padding: 34px 0 20px;
    }

    .form-header {
        background: linear-gradient(135deg, #0f2d4a 0%, #174ea6 100%);
        color: white;
        border-radius: 30px;
        padding: 34px;
        box-shadow: 0 24px 60px rgba(21, 64, 105, 0.16);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

    .form-header::before {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        right: -80px;
        top: -80px;
    }

    .form-header h1 {
        color: white;
        margin: 0 0 10px;
        position: relative;
        z-index: 2;
    }

    .form-header p {
        color: #d9e8ff;
        margin: 0;
        line-height: 1.65;
        max-width: 780px;
        position: relative;
        z-index: 2;
    }

    .form-card-modern {
        background: #ffffff;
        border: 1px solid #dbe8f4;
        border-radius: 28px;
        box-shadow: 0 18px 44px rgba(21, 64, 105, 0.09);
        padding: 34px;
        max-width: 820px;
    }

    .form-section-title {
        color: #102a43;
        font-weight: 950;
        margin-bottom: 8px;
    }

    .form-section-text {
        color: #60758a;
        margin-bottom: 26px;
        line-height: 1.6;
    }

    .form-grid-modern {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .form-grid-modern .full {
        grid-column: 1 / -1;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    @@media (max-width: 768px) {
        .form-card-modern {
            padding: 26px;
        }

        .form-header {
            padding: 28px;
        }

        .form-grid-modern {
            grid-template-columns: 1fr;
        }

        .form-grid-modern .full {
            grid-column: auto;
        }
    }
</style>

<section class="form-page">
    <div class="form-header">
        <h1>Yeni Doktor Ekle</h1>

        <p>
            Hastanede görev yapacak yeni doktor kaydını oluşturabilirsiniz.
            Doktor kaydı oluşturulduktan sonra ilgili doktora seans tanımlanabilir.
        </p>
    </div>

    <div class="form-card-modern">
        <h4 class="form-section-title">Doktor Bilgileri</h4>

        <p class="form-section-text">
            Doktorun adını, uzmanlık bilgisini, bağlı olduğu branşı ve muayene ücretini girerek kayıt işlemini tamamlayın.
        </p>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid-modern">
                <div class="full">
                    <label asp-for="FullName" class="form-label">Doktor Adı Soyadı</label>
                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Örn: Dr. Ayşe Demir" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Specialty" class="form-label">Uzmanlık</label>
                    <input asp-for="Specialty"
                           class="form-control"
                           placeholder="Örn: Kardiyoloji Uzmanı" />
                    <span asp-validation-for="Specialty" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="DepartmentId" class="form-label">Branş</label>
                    <select asp-for="DepartmentId"
                            class="form-control"
                            asp-items="ViewBag.DepartmentId">
                        <option value="">Branş seçiniz</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="ExaminationFee" class="form-label">Muayene Ücreti</label>
                    <input asp-for="ExaminationFee"
                           class="form-control"
                           placeholder="Örn: 950" />
                    <span asp-validation-for="ExaminationFee" class="text-danger"></span>
                </div>

                <div class="full">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Doktor hakkında kısa açıklama yazınız."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    Kaydet
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Listeye Dön
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}